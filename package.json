{
  "name": "@zanreal/medusa-usage",
  "version": "0.2.0",
  "description": "Medusa v2 plugin for metered usage: an append-only usage event log with pluggable event sinks, batched ingestion, deterministic deduplication and re-derivable aggregation.",
  "keywords": [
    "medusa",
    "medusa-plugin",
    "medusa-plugin-integration",
    "medusa-plugin-other",
    "medusa-v2",
    "metering",
    "plugin",
    "usage",
    "usage-based-billing"
  ],
  "homepage": "https://zanreal.com/docs/oss/medusa-usage",
  "bugs": {
    "url": "https://github.com/zanreal-labs/medusa-usage/issues"
  },
  "license": "MIT",
  "author": "ZanReal Labs <opensource@zanreal.com> (https://zanreal.com)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zanreal-labs/medusa-usage.git"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "files": [
    ".medusa/server",
    "CHANGELOG.md"
  ],
  "exports": {
    "./package.json": "./package.json",
    "./workflows": "./.medusa/server/src/workflows/index.js",
    "./.medusa/server/src/modules/*": "./.medusa/server/src/modules/*/index.js",
    "./modules/usage/module-name": "./.medusa/server/src/modules/usage/module-name.js",
    "./modules/*": "./.medusa/server/src/modules/*/index.js",
    "./providers/*": "./.medusa/server/src/providers/*/index.js",
    "./*": "./.medusa/server/src/*.js",
    "./admin": {
      "import": "./.medusa/server/src/admin/index.mjs",
      "require": "./.medusa/server/src/admin/index.js",
      "default": "./.medusa/server/src/admin/index.js"
    }
  },
  "scripts": {
    "build": "medusa plugin:build",
    "dev": "medusa plugin:develop",
    "lint": "medusa lint src",
    "check": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p src/admin/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "prepare": "medusa plugin:build",
    "prepublishOnly": "medusa plugin:build"
  },
  "devDependencies": {
    "@medusajs/admin-sdk": "2.23.0",
    "@medusajs/admin-shared": "2.23.0",
    "@medusajs/cli": "2.23.0",
    "@medusajs/eslint-plugin": "2.23.0",
    "@medusajs/framework": "2.23.0",
    "@medusajs/icons": "2.23.0",
    "@medusajs/js-sdk": "2.23.0",
    "@medusajs/medusa": "2.23.0",
    "@medusajs/test-utils": "2.23.0",
    "@medusajs/types": "2.23.0",
    "@medusajs/ui": "4.3.0",
    "@swc/core": "^1.16.2",
    "@types/node": "^20.19.43",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^10.0.0",
    "i18next": "^27.1.1",
    "jiti": "^2.7.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^18.0.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "vite": "^8.3.8",
    "vitest": "^4.0.0"
  },
  "peerDependencies": {
    "@medusajs/cli": "2.23.0",
    "@medusajs/framework": "2.23.0",
    "@medusajs/medusa": "2.23.0",
    "react-i18next": "^18.0.1"
  },
  "engines": {
    "node": ">=22.22.0"
  },
  "packageManager": "pnpm@11.13.0"
}
